<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- The doc contract lives in the compiler, not in a markdown file that
         drifts. CS1572/1573 catch a <param> naming an argument that does not
         exist; CS1574/0419 catch a cref pointing at something deleted. Both are
         the ghost-reference failure this project keeps hitting. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <!-- Not demanding a comment on EVERY public member: a required doc on a
         record property produces restatements of the property name, which is
         noise that trains everyone to ignore the check. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>

    <!-- AND A WARNING FAILS THE BUILD HERE AND NOT ONLY IN CI. The workflow has
         always had a separate step grepping for `warning (CS|xUnit)`, so the gate
         existed, but `dotnet build` SUCCEEDED locally on the same tree, and the
         two disagreeing is what let a red branch be pushed and called clean on
         2026-08-05: deleting a type left two dangling crefs, the local build
         reported success, and no test ran in CI at all.
         A CHECK THAT ONLY RUNS SOMEWHERE ELSE IS A CHECK NOBODY RUNS. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <!-- The brain is its own assembly and the reference points this way round.
       `SeparationTests` says a world may not reach into the brain and `DrivenTests`
       says where the line falls; both read text, and text is what a rename or a move
       can walk around. A project reference is the compiler's version of the same
       rule: `OpenPlexus.Brain` cannot see a world because nothing tells it where one
       is, so the twenty-five `<see cref="Worlds...">` in the brain's own comments
       stopped compiling on the day of the move and were repaired rather than
       softened. -->
  <ItemGroup>
    <ProjectReference Include="..\OpenPlexus.Brain\OpenPlexus.Brain.csproj" />
    <ProjectReference Include="..\OpenPlexus.Worlds\OpenPlexus.Worlds.csproj" />
  </ItemGroup>

  <!-- The join has no public surface, and that is the same rule one assembly out. Its types
       take a `Brain` and read a `Population`, which C# will not let a public member do while
       those are internal, so the choice is between opening the learner again and closing
       the join. Nothing outside the composition consumes these: the harness runs them and the
       tests assert on them. -->
  <ItemGroup>
    <InternalsVisibleTo Include="OpenPlexus.Host" />
    <InternalsVisibleTo Include="OpenPlexus.Talk" />
    <InternalsVisibleTo Include="OpenPlexus.Tests" />
  </ItemGroup>

</Project>
