# Local, non-shared context. Personal working notes and environment specifics.
CLAUDE.local.md

# Editors / OS
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db


# Third-party benchmark data. FETCHED, not vendored: `tools/fetch_clutrr.py` pins
# the URLs and verifies size and sha256, so "did we measure the same bytes" is
# answerable without carrying 10 MB of CSV in every clone forever.
#
# EVERY dataset directory, not a list of the ones tried so far. Listing them by
# name failed the first time a new one arrived: FB15k-237 was fetched on
# 2026-07-30 and 310,383 lines of it went into a commit, because `data/clutrr/`
# and `data/openea/` were both present and neither matched. CLAUDE.md rule 12 --
# fix the class, not the instance.
#
# A file directly in `data/` is still tracked, which is what keeps
# `tinyshakespeare.txt` where it is.
data/*/

# Python bytecode
__pycache__/
*.py[cod]

# Mutation-harness backups. Should never persist; if one is here, a run was
# killed mid-edit and tools/mutate.py will restore it on next start.
*.py.bak
.mutate.lock

# Sweep output. Written by every experiment via --json and uploaded as an
# artifact by the workflows; a stray file here gets bundled into EVERY artifact
# of every sweep, where it is indistinguishable from a result. g10-01 caught one.
out/
# Generated by tools/cluster_compose.py, which regenerates it per configuration.
docker-compose.cluster.yml
