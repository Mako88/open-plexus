# Local, non-shared context. Personal working notes and environment specifics.
CLAUDE.local.md

# Editors / OS
.vs/
.vscode/
.idea/
*.user
*.swp
.DS_Store
Thumbs.db

# .NET build output
bin/
obj/
artifacts/

# Working scratch. Overwritten freely; nothing durable may cite it.
scratchpad/

# MASTER'S WORKING ARTEFACTS, WHICH SHARE THIS DIRECTORY. A branch switch does
# not remove untracked files, so master's 640 MB of fetched benchmark data and
# its sweep results sit here whenever it has been checked out. Both are ignored
# on master too, and both must stay ignored here: `git add -A` on this branch
# was already caught starting to swallow the datasets once.
data/
out/

# Python bytecode, for the same reason. Nothing here runs Python, but running
# master's suite and switching back leaves these behind.
__pycache__/
