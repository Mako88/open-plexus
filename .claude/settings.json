{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/scripts/handoff.sh\"",
            "timeout": 20,
            "statusMessage": "Writing the session handoff before compaction"
          }
        ]
      }
    ]
  }
}
