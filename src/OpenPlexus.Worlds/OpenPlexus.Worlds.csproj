<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- A folder here is a claim about a world and never a compilation boundary, which
         `README.md` beside this file says and which every file's `namespace
         OpenPlexus.Worlds` keeps true. -->
    <RootNamespace>OpenPlexus.Worlds</RootNamespace>

    <!-- The same three gates the library has, and for the same reasons. The reasons are
         written once, on `OpenPlexus.csproj`. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <!-- A world reaches the seam and nothing past it. `SeparationTests` has said since
       2026-08-06 that a world may not name a brain type, and it said it by walking the
       filenames of the worlds that existed that day; every world built since was outside
       its list and unchecked. This reference is the version that cannot drift: the codes
       and the moment are public here, the learner is not, and a world naming `Population`
       or `Bench` does not compile. -->
  <ItemGroup>
    <ProjectReference Include="..\OpenPlexus.Brain\OpenPlexus.Brain.csproj" />
  </ItemGroup>

</Project>
