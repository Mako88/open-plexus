<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- The doc contract lives in the compiler, not in a markdown file that
         drifts. CS1572/1573 catch a <param> naming an argument that does not
         exist; CS1574/0419 catch a cref pointing at something deleted. Both are
         the ghost-reference failure this project keeps hitting. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <!-- Not demanding a comment on EVERY public member: a required doc on a
         record property produces restatements of the property name, which is
         noise that trains everyone to ignore the check. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>

    <!-- AND A WARNING FAILS THE BUILD HERE AND NOT ONLY IN CI. The workflow has
         always had a separate step grepping for `warning (CS|xUnit)`, so the gate
         existed, but `dotnet build` SUCCEEDED locally on the same tree, and the
         two disagreeing is what let a red branch be pushed and called clean on
         2026-08-05: deleting a type left two dangling crefs, the local build
         reported success, and no test ran in CI at all.
         A CHECK THAT ONLY RUNS SOMEWHERE ELSE IS A CHECK NOBODY RUNS. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

</Project>
