# Build output
bin/
obj/
[Dd]ebug/
[Rr]elease/
artifacts/

# IDE
.vs/
.idea/
*.user
*.suo

# Local settings
.claude/settings.local.json
.claude/scheduled_tasks.lock

# Python (master branch)
__pycache__/
*.pyc
out/

# Fetched corpora. The data is somebody else's and large; the script that
# fetches it is ours and small, so that one file stays.
corpora/*
!corpora/fetch.sh

# Sylvatica. `uv.lock` is NOT here on purpose: the cu126 pin is the whole
# reason the card works, and a lockfile nobody commits is a pin nobody has.
.venv/

# Somebody else's weights, gigabytes of them. `core/checkpoints.py` fetches
# them and says which; the repository carries the name, never the bytes.
checkpoints/

# Thread state and transcripts. A run's own memory, machine-local by
# definition -- a state file is meaningless beside a different checkpoint.
state/

# The general corpus the replay mix is anchored to. Somebody else's words,
# public domain, and megabytes of them; `corpora/fetch.py` is ours and stays.
corpora/*.txt

# bAbI, somebody else's data; scripts/fetch_babi.sh fetches it.
data/babi/*.jsonl
data/babi/README.md

# TinyStories, somebody else's data; src/unfused/exam/stories.py says where it is fetched from.
data/tinystories/

# FairytaleQA, somebody else's data; src/unfused/exam/fairytales.py says where it is fetched from.
data/fairytaleqa/
