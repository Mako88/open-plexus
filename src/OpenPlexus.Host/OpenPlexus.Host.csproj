<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>OpenPlexus.Host</RootNamespace>
    <AssemblyName>OpenPlexus.Host</AssemblyName>

    <!-- The same three gates the library has, and for the same reasons. The reasons are
         written once, on `OpenPlexus.csproj`. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\OpenPlexus\OpenPlexus.csproj" />
  </ItemGroup>

</Project>
