<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>OpenPlexus.Talk</RootNamespace>

    <!-- The same three gates the library has, and for the same reasons. A host that
         built to a different standard would be the one place a dangling `cref` or a
         warning could live, and it is the one place somebody runs by hand. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\OpenPlexus\OpenPlexus.csproj" />
  </ItemGroup>

</Project>
