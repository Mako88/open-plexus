.venv/
__pycache__/
*.pyc
.claude/settings.local.json
.claude/scheduled_tasks.lock
.claude/worktrees/
# Fetched corpora and models are somebody else's and large. `data/babi` is the one exception:
# it is small, and the scripts read it directly.
data/*
!data/babi/
models/
out/
# Stores and other run state live here; a store is rebuilt by hearing. The system's ledger, the
# record of every round the lineage took, is the one thing in it that is versioned.
state/*
!state/system/
state/system/*
!state/system/ledger.json
